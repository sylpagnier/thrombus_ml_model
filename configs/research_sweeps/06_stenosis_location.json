{
  "id": "06_stenosis_location",
  "title": "Stenosis axial location vs research parameters",
  "model": "locked_canonical",
  "axis": "path_loc_frac",
  "description": "Fixed 50% diameter stenosis; move pathology peak proximal / mid / distal.",
  "control": {
    "re_target": 450.0,
    "t_final_s": 30000.0,
    "n_steps": 120,
    "include_velocity": false,
    "geometry": {
      "width": 0.012,
      "curve_type": "straight",
      "angle_span": 0.0,
      "amplitude": 0.0,
      "base_length": 0.1,
      "stenosis_occlusion": 0.5,
      "seed": 42,
      "level": 0
    }
  },
  "output_dir": "outputs/research_sweeps/06_stenosis_location",
  "arms": [
    {"name": "proximal", "axis_value": 0.2, "geometry": {"path_loc_frac": 0.2}},
    {"name": "mid", "axis_value": 0.5, "geometry": {"path_loc_frac": 0.5}},
    {"name": "distal", "axis_value": 0.8, "geometry": {"path_loc_frac": 0.8}}
  ]
}
