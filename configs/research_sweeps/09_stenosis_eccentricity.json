{
  "id": "09_stenosis_eccentricity",
  "title": "Stenosis wall eccentricity vs research parameters",
  "model": "locked_canonical",
  "axis": "path_loc",
  "description": "Fixed 50% stenosis; top-only vs bottom-only vs both-wall (symmetric).",
  "control": {
    "re_target": 450.0,
    "t_final_s": 30000.0,
    "n_steps": 120,
    "include_velocity": false,
    "geometry": {
      "width": 0.012,
      "curve_type": "straight",
      "angle_span": 0.0,
      "amplitude": 0.0,
      "base_length": 0.1,
      "stenosis_occlusion": 0.5,
      "path_loc_frac": 0.5,
      "pathology_std_frac": 0.06,
      "seed": 42,
      "level": 0
    }
  },
  "output_dir": "outputs/research_sweeps/09_stenosis_eccentricity",
  "arms": [
    {"name": "top_only", "axis_value": 0, "geometry": {"path_loc": 0}, "labels": {"path_loc": 0}},
    {"name": "bot_only", "axis_value": 1, "geometry": {"path_loc": 1}, "labels": {"path_loc": 1}},
    {"name": "both_walls", "axis_value": 2, "geometry": {"path_loc": 2}, "labels": {"path_loc": 2}}
  ]
}
