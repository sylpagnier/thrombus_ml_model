  "output_dir": "outputs/research_sweeps/02_aneurysm_strength",
  "arms": [
    {"name": "af_0.00", "axis_value": 0.0, "geometry": {"aneurysm_factor": 0.0}},
    {"name": "af_0.25", "axis_value": 0.25, "geometry": {"aneurysm_factor": 0.25}},
    {"name": "af_0.50", "axis_value": 0.5, "geometry": {"aneurysm_factor": 0.5}},
    {"name": "af_1.00", "axis_value": 1.0, "geometry": {"aneurysm_factor": 1.0}}
